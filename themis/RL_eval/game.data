[base]
env_name = None

# Multi-GPU (single GPU defaults)
gpu_offset = 0

profile = 0
checkpoint_dir = checkpoints
log_dir = logs
checkpoint_interval = 500
eval_episodes = 10000
eval_agents = -1
load_model_path = 'None'
load_enemy_model_path = 'None'
run_id = 'None'
result_fd = 0

# CUDA graphs (first real rollout/train use). >=0 enable, -1 disable.
cudagraphs = 1
seed = 73
# If true, zero RNN state every horizon (ablation). If false (default carry),
# state persists across horizons and resets only on terminal.
reset_every_horizon = 0

# Cleanba-style learner/actor pipelining: rollouts use a one-epoch-stale actor
# snapshot while the learner trains the previous horizon. Works with carry
# (reset_every_horizon=0) via per-slot initial_states.
async = 1

[vec]
total_agents = 4096
num_buffers = 2
num_threads = 8
# Total policies including trainable policies[0]. 1 = train only.
num_policies = 1
# Required > 0 when num_policies > 1 (historical opponent arch).
hist_policy_hidden_size = 0
hist_policy_num_layers = 0
# Fraction of envs (0â€“1) assigned to historical policies when num_policies > 1.
hist_policy_percent = 0

# Selfplay-pool training. When enabled, hist_policy_percent of agent slots (see
# [vec]) play against older checkpoints from the current run. Opponents are
# resampled from the pool every opp_timeout_steps global steps (0 = never).
# At end of train, final policy scoring (first match wins):
#   eval_bot_games > 0 â†’ mean env/perf vs the eval_bots ladder (1 Protein point)
#   else eval_games > 0 â†’ mean A winrate vs up to eval_pool_size pool opps
[selfplay]
enabled = 0
max_size = 16
seed = 42
# Resample each historical opponent after this many global steps. 0 = never.
opp_timeout_steps = 500_000_000
eval_pool_size = 8
eval_games = 0
# 0 = off. >0 = after train, eval final vs each bot in eval_bots for this many
# episodes each; mean env/perf becomes TrainResult.score (points=1 for Protein).
eval_bot_games = 0
# Ladder rungs, weakest first: the [env] bot_policy ids the env's header
# defines. Required when eval_bot_games > 0, e.g. eval_bots = 3,4,5,6.
eval_bots = 0
eval_bot_envs = 8192
eval_bot_threads = 0

# Per-rung [env] overrides for the bot ladder, as full section.key = value
# lines (e.g. env.dr = 0). Env-owned so core needs no per-env knowledge.
[bot_eval]

# Args used by your env's binding.c go here
[env]
dr = 0
num_agents = 1
num_bots = 0

[policy]
hidden_size = 128
num_layers = 4

[train]
gpus = 1
total_timesteps = 10_000_000
learning_rate = 0.015
anneal_lr = 1
min_lr_ratio = 0.0
gamma = 0.995
gae_lambda = 0.90
replay_ratio = 1.0
clip_coef = 0.2
vf_coef = 2.0
vf_clip_coef = 0.2
max_grad_norm = 1.5
ent_coef = 0.001
# Cosine-anneal ent_coef like lr does. Off by default (matches old behavior).
# When on: ent_coef decays from its base value to min_ent_coef_ratio * ent_coef
# over total_timesteps. Useful late in training to let a learned policy commit
# harder on its preferences once the entropy bonus is no longer load-bearing.
anneal_ent_coef = 0
min_ent_coef_ratio = 0.1
momentum = 0.95
minibatch_size = 8192
horizon = 64
# vtrace=0: GAE with Ï=1. vtrace=1: puff_advantage clips Ï/c.
vtrace = 0
vtrace_rho_clip = 1.0
vtrace_c_clip = 1.0

# Verb-eps exploration floor (experimental, Nethack; see src/algo.cu). 0 = off.
verb_eps = 0.0
verb_eps_anneal_start = 0.4
verb_eps_anneal_end = 1.0

[sweep]
metric = score 
metric_distribution = linear
goal = maximize
max_suggestion_cost = 3600
max_runs = 1200
gpus = -1
downsample = 5
prune_pareto = 1
early_stop_quantile = 0.3

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 1e11
scale = time

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 1024
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 1
max = 8
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 256
max = 16384
scale = auto

#[sweep.vec.num_buffers]
#distribution = uniform
#min = 1
#max = 8
#scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 512
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 1.0
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.gamma]
distribution = logit_normal
min = 0.8
max = 0.9999
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.2
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 0.25
max = 4.0
scale = auto

# Lower clip is sometimes better but less stable
[sweep.train.clip_coef]
distribution = uniform
min = 0.1
max = 0.9
scale = auto

# Optimal vf clip can be lower than 0.1,
# but this results in jank unstable runs
[sweep.train.vf_clip_coef]
distribution = uniform
min = 0.01
max = 5.0
scale = auto

[sweep.train.vf_coef]
distribution = uniform
min = 0.1
max = 4.0
scale = auto

[sweep.train.max_grad_norm]
distribution = uniform
min = 0.1
max = 1.5
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.5
max = 0.999
scale = auto
[base]
env_name = themis
async = 1
reset_every_horizon = 0

[vec]
# 4 drones per env; total_agents / num_drones envs in parallel
total_agents = 4096
num_buffers = 8
num_threads = 8

[env]
num_drones = 4
course_bank = training/course_bank/bank_v1.bin
# held-out evaluation: courses with index >= eval_split are never sampled in train
eval_split = 250
# eval only: walk the held-out courses in order and reseed every episode, so two
# variants of the env are compared on identical runs (2, 3...: other seed sets)
paired_eval = 0
eval = 0

# policy / planner rate: physics 100 Hz, planner every `subticks` ticks (4 = 25 Hz)
subticks = 4
# 90 s: courses run 29-44 m for 80 % of seeds since the obstacle spacing became mixed (course/README)
horizon_s = 90

# --- residual bounds (m/s). 0 = pure classical baseline ---
rl_bound_speed = 0.5
rl_bound_lat = 0.3
rl_bound_z = 0.3

# --- classical speed profile (baseline) ---
v_cruise = 2.5
# At v_bend45 1.5 each 25-50 degree kink cost 0.4-0.5 tape contacts on the realistic
# setup (camera lateral, 1.5 m sight); 0.9 / 0.65 scored best in the 2026-10-29 sweep.
v_turn90 = 0.65
v_bend45 = 0.9
v_narrow = 1.5
v_hurdle = 1.5
v_finish = 0.8
a_profile = 2.5

# --- formation (tape frame) ---
form_long = 0.45
# Lateral spacing: equal gaps tape-drone-drone-tape for the CAD drone width
# (th_box_half_at), clamped to the brief's suggested 300-600 mm centre to centre.
# In a 900 mm corridor that is 371 mm for the 213 mm Themis 35, with 158 mm gaps.
# The same rule gave the fixed 383 mm used for the old 250 mm assumption; at 450 mm
# the tape margin was only 100 mm, which is where the contacts were.
form_lat_max = 0.6
form_lat_min = 0.30
# lateral margin below which a 2-wide box is not flyable -> deviate to single file
line_enter_margin = 0.06
# single file forms 0.6 m plus this many seconds at the current speed before the narrowing
line_lead_s = 0.8
# 1: no drone flies faster than the profile over its own stretch ahead, even when
# catching up to its slot. Off, followers took kinks up to 35% + 0.3 m/s over the cap.
cap_local = 1
# slot-offset blend rate during a mode change (m/s of offset)
blend_rate = 1.6
lat_margin = 0.025
k_slot_s = 1.5
k_slot_lat = 1.5
k_z = 2.0
speed_lead_s = 0.5
# outer-loop integrators (conditional anti-windup); removes the standing offset a
# P law leaves under a persistent side disturbance
k_lat_i = 0.8
k_z_i = 0.8
i_limit = 0.35
# separation field: activation distance is scheduled from the commanded slot
# spacing, so it never fights the formation it protects
apf_damp = 0.8
apf_v_rep = 1.2
# imminent-contact band above physical contact (2 x 125 mm)
sep_margin = 0.15
# abreast conflict: how hard the drone ahead of its slot yields
sep_yield = 0.6
# formation reference hold-back for a lagging drone. The floor is load-bearing:
# a hard stall is a positive feedback loop (drone yields -> reference waits ->
# swarm crawls -> run times out).
# the centroid is pulled toward the swarmâ€™s own mean progress at this rate (1/s)
k_ref = 1.0
ref_lag_start = 0.3
ref_lag_band = 0.8
ref_lag_floor = 0.25
# Formation reference. 0: the integrator above, fed every drone's true progress
# (the original env). 1: the mean of the drones' slot-corrected progress, which
# needs no tuning and leaves slot errors that describe the shape only.
sref_mode = 0
# Progress each drone uses for formation keeping. 0: the truth. 1: odometry with
# fixes at tape features against the leader's log (no map needed), each feature
# matched by its look and where the drone expects it. 2: odometry only. Above 0 the
# measured reference is used, built from the broadcasts below. The realistic setup
# (prog_est, uwb_ranges, cam_model, see_range, local_form, slide_90 below) is the default
# since contract 4: the policy trains on what the drones can sense.
prog_est = 1
# chance a drone's camera misses a feature it passes
lm_miss = 0.0
# 1: the gap hold and separation field use noisy UWB ranges (uwb_noise) and the
# neighbours' broadcasts instead of true relative positions
uwb_ranges = 1
# odometry scale error per drone (1 sd, fraction of distance), velocity noise (m/s),
# feature fix noise (m)
odo_scale_sd = 0.03
odo_noise = 0.1
lm_noise = 0.03
# progress broadcasts: period and latency in 100 Hz ticks, loss per receiver
bcast_ticks = 2
bcast_delay = 2
bcast_loss = 0.1
# A/B gates for the control-law changes (see README). use_z_ff is OFF because it
# measured WORSE than a fixed 1 m height lookahead: exact slope feedforward sets
# the rate correctly but the plant still lags in phase, and the fixed lookahead
# is simply more conservative into a descending ceiling.
act_squash = 1
slot_swap = 1
swap_span_m = 0.45
swap_offset_m = 0.15
swap_margin = 0.02
use_lat_ff = 1
use_z_ff = 0
use_vert_cap = 1
use_apf = 1
# Taking along-track straight from the speed profile instead of projecting the
# pursuit vector. Measured WORSE (more tape contacts, longitudinal error barely
# moved), so off: the cos(theta) loss was not the cause it looked like.
decouple_axes = 0
# compensate the longer path an outer-lane drone traces through a turn
use_path_ff = 1
# window the turn is spread over; integrated it always totals l*dtheta
path_ff_win = 0.6
# formation through narrowings: 1 = single file (line) inside the 2 s deviation allowance, 0 = compressed box
allow_line = 1
line_gap = 0.30
# follow-gap hold to the drone ahead in the lane (UWB range hold)
gap_k = 2.0
# lane compression through corners
corner_lat_scale = 0.9
# lateral safety prediction horizon (s) ~ plant response time
safety_T = 0.5

# --- PX4-equivalent cascade limits (MPC_* equivalents) ---
xy_vel_max = 4.0
z_vel_max_up = 1.5
z_vel_max_dn = 1.0
acc_hor = 6.0
acc_z = 4.0
jerk_max = 20.0
tilt_max_deg = 45
vel_p = 2.5
vel_i = 0.4
vel_d = 0.2
z_vel_p = 4.0
z_vel_i = 2.0
att_p = 6.5
yaw_p = 2.8
rate_p = 25.0
rate_max_dps = 220
yaw_rate_max_dps = 120

# --- safety filter ---
sep_min = 0.30
clear_min = 0.20
z_min = 0.30
z_max = 1.45

# --- the drone, from the CAD (CAD/build/<frame>/<frame>-validation.json and parts) ---
# plan half-width square to the track, half-width yawed 45 deg, half-height about the
# CG. Themis 35 r3: 106.7 / 132.0 / 91 mm. CineLog35 V2: 103.4 / 127.6 / 81 mm.
# The env assumed a 250 mm sphere (125 / 125 / 125) until 2026-10-29.
drone_half_w = 0.1067
drone_half_w45 = 0.132
drone_half_h = 0.091
# a tape contact starts this far inside the tape's centre line: 0 if the drone has to
# cross the centre line, 0.025 if any part over a 50 mm tape counts (rule unconfirmed)
tape_in = 0.0
# share of the drone's width that must be over that line before it counts as a contact.
# Assumed 0.5 (more than half the body over the line, i.e. its centre past it): the
# organisers are expected to be lenient. 0 counts any part crossing. Judging only.
tape_over = 0.5
# The formation counts as tight while its RMS shape error is within this (m). The judged
# formation points (th_score) grade the share of box time it is tight.
form_tol = 0.10
# Lateral sensing. 0: the planner reads its offset from the centre line and the tape's
# heading exactly. 1: a downward camera's report, 40 ms late, with pixel noise (m), a
# per-drone attitude bias (rad, 0.009 = 0.5 deg) and height scale error, heading noise
# (rad), and noise multiplied by cam_corner at a 90-degree corner.
cam_model = 1
cam_noise = 0.01
cam_att_sd = 0.009
cam_scale_sd = 0.02
cam_head_noise = 0.01
cam_corner = 3.0
# How far past the front-most drone the swarm can see the course (m); 0 = all of it, as
# with a map. Without a map, speed limits and single file come only from what is in view.
# 3 m: the forward camera, tilted 20 degrees down, keeps 0.5-4 m of floor in frame with the
# tape ~7 px wide at 3 m (the downward camera alone sees ~1.5 m). Worth ~1 point and 3 s a
# lap to the classical controller on the mixed courses. With cam_fwd 1 it is only the
# nominal sight: each run draws its own (below).
see_range = 3
# The forward camera's tape detection, modelled (1) or perfect out to see_range (0). Past
# the downward camera's reach (fwd_near) every feature (a turn, a narrowing, the hurdle,
# the finish) comes from the forward camera: placed fwd_range_sd off (m, 1 sd: 0.5 deg of
# attitude error is ~9 cm at 3 m, plus a pixel), each turn's angle fwd_angle_sd off (rad,
# ~3 deg), or missed with fwd_miss until the downward camera reaches it. How far it reliably
# sees is drawn per run in [fwd_sight_min, fwd_sight_max]: its sensor is monochrome, so the
# tape's contrast with an unknown floor decides it.
cam_fwd = 1
fwd_sight_min = 2.0
fwd_sight_max = 3.5
fwd_near = 1.5
fwd_range_sd = 0.10
fwd_angle_sd = 0.05
fwd_miss = 0.1
# 1: hold each drone's nose along the tape; 0: point it at its pursuit target
yaw_track = 0
# Controller. 0: centroid and slots (the virtual structure). 1: local references, no
# centroid: lanes from the tape, each follower's slot held to the front-right drone (the
# leader, which sets the speed and broadcasts it with its progress), measured by progress
# estimates trimmed by UWB ranges (implies prog_est = 1); a compact box slides through
# 90-degree turns. 2: the same on true distances.
local_form = 1
# local references: slide a compact box through 90-degree turns (0: follow the lanes round)
slide_90 = 0
# how far either side of the box centre (m) a slide starts and ends
slide_a = 0.55
# local references: 0 the front-right slot holder leads; 1 elect the front-most drone
leader_mode = 0
# leader_mode 1: elect only from the front pair (0: any slot)
leader_front_only = 1
# election hysteresis (m) and minimum dwell (s) when leader_mode = 1
leader_margin = 0.15
leader_dwell_s = 1.0

# --- domain randomisation ---
dr = 0.15
latency_ticks_min = 2
latency_ticks_max = 6
tape_noise = 0.02
heading_noise = 0.03
uwb_noise = 0.05
comms_loss = 0.1
disturbance = 0.5

# --- reward (mirrors the scoreboard) ---
# Reward weights are scaled to the competition scoreboard, so the policy's
# internal trade matches the one that actually scores points. The first run
# showed why this matters: progress paid 1.0/m over a ~27 m course (~+27
# available) against 2.0 per contact, so ~14 contacts cancelled the whole
# progress term and the policy was near-indifferent between speed and staying
# inside the tape. It correctly chose speed, and lost on the scoreboard.
#
#   scoreboard          reward equivalent over one run
#   time      6 pts     alpha_progress * course length  ~= 27 m * 0.2 = 5.4
#   completion 3 pts    finish_bonus = 3
#   formation 6 pts     alpha_form * race_time * form_err ~= 1.2 * 25 * 0.18 = 5.4
#   contact  -2 pts     pen_* = 2.0 each, already exact
#   DNF                 loses completion + time, so pen_kill = 9
#
# Note the speed incentive comes from DISCOUNTING, not from alpha_progress:
# progress pays per metre, so the total is the same at any speed, but gamma
# makes earning it sooner worth more.
# seconds cost points directly: a 25 s run pays 7.5, a 40 s run 12, which is
# about the 6-point spread the race awards for finishing order
alpha_time = 0.3
t_target = 26.0
# Above 0, the free time is t_pace seconds per metre of the course instead: 26 s suited the
# old ~28 m courses, but on the mixed ones (29-44 m, the classical controller ~1.18 s/m)
# it charges most of every run.
t_pace = 0
alpha_progress = 0.2
# Formation, pointed at what the judges grade (contract 4): alpha_form charges the RMS
# shape error about the swarm's own mean; alpha_tight credits every second the box is
# tight (form_tol), shared by all four, ~0.15 * 35 s of box time = 5 for a tight run
# against the 6 judged points; alpha_late charges each second a re-form runs past 2 s.
alpha_form = 1.2
alpha_tight = 0.15
alpha_late = 1.0
alpha_z = 1.0
alpha_action = 0.01
alpha_oob = 0.3
alpha_jerk = 0.05
# a command the safety filter vetoes must produce gradient, not silence
alpha_clip = 0.05
pen_tape = 2.0
pen_drone = 2.0
pen_obstacle = 2.0
pen_kill = 9.0
pen_near = 0.05
# dense approach cost for the corridor edge, the analogue of pen_near for the
# tape: ramps up over the last edge_band metres of lateral margin
pen_edge = 1.5
edge_band = 0.12
finish_bonus = 3.0

[policy]
hidden_size = 64
num_layers = 2

[train]
total_timesteps = 200_000_000
horizon = 64
gamma = 0.99
gae_lambda = 0.95
learning_rate = 0.001
minibatch_size = 16384
clip_coef = 0.2
vf_coef = 0.5
ent_coef = 0.001
max_grad_norm = 1.0

[sweep]
metric = perf
# Web overlay for the RL_eval page (packed by build.sh via PUFFER_WEBSITE_DIR=training/web).
# Smaller course bank so the page stays light; everything else from config/themis.ini,
# including the realistic sensing both controllers fly on (the T switch keeps prog_est on
# for the centroid too, so it compares like with like).
[env]
course_bank = resources/themis/bank_web.bin
eval_split = 40
eval = 1
